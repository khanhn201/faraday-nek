#define INTP_NMAX 3000
#define NPTS_MAX INTP_NMAX

#define INTP_X 160
#define INTP_Y 120
#define NPTS_SLICE (INTP_X*INTP_Y)

c  total height = Y_HEIGHT_MAX*0.05
#define Y_HEIGHT_MAX 3.0

      include "experimental/lvlSet.f"
      include "experimental/lserrors.f"
c-----------------------------------------------------------------------
      subroutine initialize_par
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /dimen/ Re,We,Fr,charl,udim
      real Re, We, Fr, charl, udim

      common /excite/ omega, magnitude
      real omega, magnitude

      common /my_vp/ rhol,rhog,mul,mug
      real rhol, mul, rhog,mug
      real hl, hg, km, cothg, cothl, gdim, gamm

      gdim = 9.81              ! gravity
      rhol = 998.0             ! density of bottom layer
      rhog = 826.0             ! density of top layer
      mul = 0.000998           ! dynamic viscosity of bottom layer
      mug = 0.002478           ! dynamic viscosity of top layer
      charl = 0.05             ! height of the bottom layer
      gamm = 0.018             ! surface tension

      hl = charl
      hg = charl*(Y_HEIGHT_MAX-1.0)
      km = 2*pi/0.2
      omega = (rhol-rhog)*gdim*km + gamm*km**3
      cothl = cosh(km*hl)/sinh(km*hl)
      cothg = cosh(km*hg)/sinh(km*hg)
      omega = omega/(rhol*cothl + rhog*cothg)
      omega = sqrt(omega)*2
      magnitude = 0.5*gdim/omega**2 ! Fig. 7

      udim = sqrt(gdim*charl)  ! characteristic velocity
      udim = omega*magnitude   ! could also be omega*magnitude of the excitation

      Re = rhol*udim*charl/mul
      Fr = udim**2.0/(gdim*charl)
      We = charl*rhol*udim**2.0/gamm

      return
      end
c-----------------------------------------------------------------------
      subroutine my_surface_track
      implicit none
      include 'SIZE'
      include 'TOTAL'

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr

      real xp(NPTS_MAX),yp(NPTS_MAX)
      real zp(NPTS_MAX),up(NPTS_MAX)
      integer iwk(INTP_NMAX,3)
      real rwk(INTP_NMAX,ldim+1)

      real h_surface, nondimtime
      integer npts, i

      integer ih
      save ih

      integer icalld
      save    icalld
      data    icalld /0/

      common /dimen/ Re,We,Fr,charl,udim
      real Re, We, Fr, charl, udim

      common /excite/ omega, magnitude
      real omega, magnitude
      real xmn,xmx,ymn,ymx,zmn,zmx, nondimh

      call domain_size(xmn,xmx,ymn,ymx,zmn,zmx)

      npts = 0
      if (nid.eq.0) then
         npts = NPTS_MAX

         do i = 1,npts
c           define points
            xp(i) = xmx/2.0
            yp(i) = real(i-1) / real(npts-1) * ymx
            zp(i) = zmx/2.0
         enddo
      endif


      if (icalld.eq.0) then
        icalld = 1
        call interp_setup(ih,0.0,0,nelv)
      endif
      call interp_nfld(up,t(1,1,1,1,ifld_cls-1),1,
     $                 xp,yp,zp,npts,
     $                 iwk,rwk,INTP_NMAX,
     $                 .true.,ih) ! T = relocate points

c     find the surface up(i) = 0.5
      h_surface = 0.0
      if (nid.eq.0) then
         do i = 1,npts
             if (up(i-1) .gt. 0.5 .and. up(i) .le. 0.5) then
c              linear interpolation between (yp(i-1), up(i-1)) and (yp(i), up(i))
             h_surface = yp(i-1) +
     $            (0.5 - up(i-1)) * (yp(i) - yp(i-1)) /
     $            (up(i) - up(i-1))
                 exit
             endif
         enddo
         nondimtime = charl/udim*time
         nondimtime = nondimtime*omega/(2.0*pi)
         nondimh = (h_surface-1.0)*0.05/magnitude
         write(*,*)time, nondimtime
     $            ,h_surface, nondimh, "Surface height"
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine dump_slice
      implicit none
      include 'SIZE'
      include 'TOTAL'
      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr

      real xp(NPTS_SLICE), yp(NPTS_SLICE)
      real zp(NPTS_SLICE), up(NPTS_SLICE)
      integer iwk(NPTS_SLICE,3)
      real rwk(NPTS_SLICE,ldim+1)

      real h_surface
      integer npts, i, j, idx

      integer ih
      save ih
      character*128 fname

      integer icalld
      save    icalld
      data    icalld /0/

      integer idump_count
      save    idump_count
      data    idump_count /0/

      real xmn,xmx,ymn,ymx,zmn,zmx

      call domain_size(xmn,xmx,ymn,ymx,zmn,zmx)

      npts = 0
      if (nid.eq.0) then
         do j = 1, INTP_Y
            do i = 1, INTP_X
               idx = (j-1)*INTP_X + i
               xp(idx) = real(i-1) / real(INTP_X-1) * xmx
               yp(idx) = real(j-1) / real(INTP_Y-1) * ymx
               zp(idx) = zmx / 2.0
            enddo
         enddo
         npts = INTP_X * INTP_Y
      endif

      if (icalld.eq.0) then
         icalld = 1
         call interp_setup(ih, 0.0, 0, nelv)
      endif

      call interp_nfld(up, t(1,1,1,1,ifld_cls-1), 1,
     $                 xp, yp, zp, npts,
     $                 iwk, rwk, NPTS_SLICE,
     $                 .true., ih)

      if (nid.eq.0) then
         idump_count = idump_count + 1
         write(fname,'("slice_",I8.8,".txt")') idump_count
         open(unit=33, file=fname, status='unknown')
         write(33,*) npts, time
         do i = 1, npts
            write(33,'(3E15.6)') xp(i), yp(i), up(i)
         enddo
         close(33)
      endif

      return
      end

c-----------------------------------------------------------------------
      subroutine uservp(ix,iy,iz,eg) ! set variable properties
      implicit none
      integer ix,iy,iz,eg,e

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr

      common /dimen/ Re,We,Fr,charl,udim
      real Re, We, Fr, charl, udim

      common /excite/ omega, magnitude
      real omega, magnitude

      common /my_vp/ rhol,rhog,mul,mug
      real rhol, mul, rhog, mug

      real hl, hg, km, cothg, cothl
      real psi
      integer icalld
      save icalld
      data icalld /0/

      e = gllel(eg)

      if(ifield.eq.1)then
        psi = t(ix,iy,iz,e,ifld_cls-1)
        psi = max(0.0,psi)
        psi = min(1.0,psi)
        utrans = ((1.0-psi)*rhog + psi*rhol)/rhol
        udiff = ((1.0-psi)*mug + psi*mul)/mul/Re
        if(istep.le.2)then
          vtrans0(ix,iy,iz,e) = utrans
        else
          vtrans0(ix,iy,iz,e) = rhog/rhol
        endif
      else
        utrans = 1.0
        udiff = 1e-10
        if(ifavm(ifield-1))then
          udiff = 1e-10       !must be tiny for hyperbolic
        elseif(ifsvv(ifield-1))then
          udiff = 1e-10      !must be tiny for hyperbolic
        endif
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userf(ix,iy,iz,eg) ! set acceleration term
      implicit none
      integer ix,iy,iz,eg,e

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /excite/ omega, magnitude
      real omega, magnitude

      common /dimen/ Re,We,Fr,charl,udim
      real Re,We,Fr, charl, udim

      real sfx,sfy,sfz, fexcite

      real svvx,svvy,svvz

      e = gllel(eg)

      sfx = 0.0
      sfy = 0.0
      sfz = 0.0
      svvx = 0.0
      svvy = 0.0
      svvz = 0.0

      call surfacetension(ix,iy,iz,e,1./We,sfx,sfy,sfz)

      call svv_fluid(ix,iy,iz,e,svvx,svvy,svvz)

      ! acceleration term from excitation
      fexcite = -omega**2*sin(omega*charl/udim*time)
      fexcite = magnitude*fexcite ! m/s^2
      fexcite = charl/udim**2*fexcite ! nondimensionalize

c     ffx = svvx
c     ffy = svvy
c     ffz = svvz 

c     abfx(ix,iy,iz,e) = sfx
c     abfy(ix,iy,iz,e) = sfy + vtrans(ix,iy,iz,e,1)*(-1./Fr + fexcite) 
c     abfz(ix,iy,iz,e) = sfz

      sfx = sfx/vtrans(ix,iy,iz,e,1)
      sfy = sfy/vtrans(ix,iy,iz,e,1)
      sfz = sfz/vtrans(ix,iy,iz,e,1)

      ffx = svvx + sfx
      ffy = svvy + sfy -1./Fr + fexcite 
      ffz = svvz + sfz 
      abfx(ix,iy,iz,e) = 0.0
      abfy(ix,iy,iz,e) = 0.0
      abfz(ix,iy,iz,e) = 0.0

      return
      end
c-----------------------------------------------------------------------
      subroutine userq(ix,iy,iz,eg) ! set source term
      implicit none
      integer ix,iy,iz,eg,e

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr
      real signls

      e = gllel(eg)

      qvol = 0.0
      avol = 0.0

      call limit_cls(ix,iy,iz,e)

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc(ix,iy,iz,iside,eg) ! set up boundary conditions
      implicit none
      integer ix,iy,iz,iside,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr


      integer e
      real yplus
      real xx,yy,heaviside
      real y_height
      real blasius

      e = gllel(eg)

      xx = xm1(ix,iy,iz,e)
      yy = ym1(ix,iy,iz,e)

      ux   = 0.0
      uy   = 0.0
      uz   = 0.0


      return
      end
c-----------------------------------------------------------------------
      subroutine useric(ix,iy,iz,eg) ! set up initial conditions
      implicit none
      integer ix,iy,iz,eg,e

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr

      common /excite/ omega, magnitude
      real omega, magnitude

      real blasius

      real xx,yy,heaviside, tx,ty, slope
      real h_local, v_local
      real phix, phiy

      real xmn,xmx,ymn,ymx,zmn,zmx

      call domain_size(xmn,xmx,ymn,ymx,zmn,zmx)

      e = gllel(eg)

      xx = xm1(ix,iy,iz,e)
      yy = ym1(ix,iy,iz,e)

      h_local = 1.0 - magnitude/0.05*1e-3*cos(xx/xmx*2*3.1415)     ! small initial wave
      h_local = h_local + magnitude/0.05*1e-4*(1.0-2.0*(xx/xmx)) ! small linear perturbation to eliminate symmetry

      ux = 0.0
      uy = 0.0
      uz = 0.0

      temp = h_local - yy

      if(ifield.eq.ifld_tls .or. ifield.eq.ifld_tlsr)then
        continue
      elseif(ifield.eq.ifld_cls .or. ifield.eq.ifld_clsr)then
        temp = heaviside(ix,iy,iz,e,temp,0.0)
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk()
      implicit none
      include 'SIZE'
      include 'TOTAL'

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr

      real ntlsr, nclsr
      real pta(3),ptb(3)

      common /dimen/ Re,We,Fr,charl,udim
      real Re,We,Fr, charl, udim
      common /excite/ omega, magnitude
      real omega, magnitude

      real phase
      real output_phase(6)
      real prevphase
      save prevphase
      data prevphase /0.0/

      integer ntot,i

      real exact(lx1*ly1*lz1*lelv)
      save exact
      real psiini(lx1,ly1,lz1,lelv)
      save psiini
      real err

      real ls_volerr

      real glsum
      integer pord
      integer ncut

      integer nface, f, e
      real w(lx1*ly1*lz1),w2(lx1*ly1*lz1)

      ntot = lx1*ly1*lz1*nelv

      call my_surface_track
      if(istep.eq.0)then
        call copy(psiini,t(1,1,1,1,ifld_cls-1),ntot)
        call copy(exact,t(1,1,1,1,ifld_tls-1),ntot)
        do i=1,ntot
          if(exact(i).ge.0.0)then
            exact(i) = 1.0
          else
            exact(i) = 0.0
          endif
        enddo
      endif

      pord = uparam(3)
      call extrappr(prext,pr,prlag(1,1,1,1,1),prlag(1,1,1,1,2),pord)
c     ncut = lx1-1
c     if(pord.ne.1) call cut_off_filter(prext,ncut,1)

      ntlsr = uparam(1) !freq of TLS re-distancing
      nclsr = uparam(2) !freq of CLS re-distancing

      call LS_default_driver(ntlsr,nclsr)

      err = ls_volerr(ifld_cls,exact,psiini)
      if(nio.eq.0)then
        write(*,*)"Volume error",err
      endif


      phase = omega*charl/udim*time
      phase = mod(phase,4.0*pi)/4.0/pi ! omega_m = 0.5*omega_e so period is 4*pi
      output_phase(1) = 0.0
      output_phase(2) = 1.0/5.0
      output_phase(3) = 1.5/5.0
      output_phase(4) = 2.0/5.0
      output_phase(5) = 3.0/5.0
      output_phase(6) = 4.0/5.0

      if(nio.eq.0)then
        write(*,*)"Excite", omega, magnitude
        write(*,*)"Phase",phase
      endif
      do i = 2,6
         ! normal crossing
         if (prevphase .lt. output_phase(i) .and.
     &       phase     .ge. output_phase(i)) then
             if(nio.eq.0)then
                    write(*,*)"Dump phase",output_phase(i)
             endif
             call outpost(vx,vy,vz,pr,t(1,1,1,1,1),'pha')
         endif
      enddo

       ! wrap-around case (phase reset at 1 → 0)
      if (prevphase .gt. phase) then
           if(nio.eq.0)then
                  write(*,*)"Dump phase",0.0
           endif
           call outpost(vx,vy,vz,pr,t(1,1,1,1,1),'pha')
       endif

      if (mod(prevphase,0.05).gt. mod(phase,0.05)) then
           call dump_slice ! every 1/20 of a period
       endif



      prevphase = phase

      return
      end
c-----------------------------------------------------------------------
      subroutine userqtl ! Set thermal divergence

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat()   ! This routine to modify element vertices
      implicit none

      include 'SIZE'
      include 'TOTAL'

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates
      implicit none

      include 'SIZE'
      include 'TOTAL'

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr

      integer ntot,i


      ifld_cls = 2
      ifld_tls = 3
      ifld_clsr = 4
      ifld_tlsr = 5

      ntot = lx1*ly1*lz1*nelv
      call cmult(ym1, Y_HEIGHT_MAX, ntot) ! scale to Y_HEIGHT_MAX
      call cmult(xm1, 1.0/0.05, ntot)     ! hard coded x length to be 0.2
      call cmult(zm1, 1.0/0.05, ntot)

      call initialize_par

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3()
      implicit none

      include 'SIZE'
      include 'TOTAL'
      include 'SVV'
      include 'AVM'

      real eps,dt_cls_in,dt_tls_in
      integer nsteps_cls, nsteps_tls

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr
      integer ifdebug, ifixCLSbdry
      real farfield


      eps = 1.5/(lx1-1.0)
      ifdebug = 0
      ifixCLSbdry = 0

      call ls_init(ifld_cls, ifld_clsr,
     $             ifld_tls, ifld_tlsr,
     $             eps, ifdebug, ifixCLSbdry, farfield)

c---------------------------------------------------------------------
c     This section to specify user defined parameters
c     for AVM/SVV. Leave commented to use default parameters
c     parameters.

      !fluid
      svv_c0(1) = 1.0
      svvcut(1) = (lx1-1.0)/2.0

      ! svv_c0(ifld_cls) = 1.0                 !ifld_cls
      ! svvcut(ifld_cls) = (lx1-1.0)/2.0-1.0
      ! svv_k0(1) = 1.5
      ! svv_k1(1) = 1.5
      ! ifnlsvv(1) = .true.

      ! avm_c1(1) = 1.0
      ! avm_ncut(1) = 1.0
      ! icont(1) = .false.
      ! ifupwindsvv(ifld_cls) = .true.

c     scalar 2
      ! svv_c0(ifld_tls) = 1.0                  !ifld_tls
      ! svvcut(ifld_tls) = (lx1-1.0)/2.0-1.0
      ! svv_k0(2) = 1.5
      ! svv_k1(2) = 1.5
      ! ifnlsvv(2) = .false.
      ! ifupwindsvv(ifld_tls) = .true.

c     scalar 3
      svv_c0(ifld_clsr) = 1.0                  !ifld_clsr
      svvcut(ifld_clsr) = (lx1-1.0)/2.0
      ! svv_k0(3) = 1.5
      ! svv_k1(3) = 1.5
      ! ifnlsvv(3) = .false.
      ! ifupwindsvv(ifld_clsr) = .true.

c     scalar 3
      svv_c0(ifld_tlsr) = 2.0                  !ifld_tlsr
      svvcut(ifld_tlsr) = (lx1-1.0)/3.0
      ! svv_k0(4) = 1.5
      ! svv_k1(4) = 1.5
      ! ifnlsvv(4) = .false.
      ! ifupwindsvv(ifld_tlsr) = .true.

      return
      end
