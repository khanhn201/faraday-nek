#!/bin/bash
#SBATCH --account=bcla-delta-cpu
#SBATCH --job-name=nek5000_fara
#SBATCH -o %x-%j.out
#SBATCH --time=06:00:00
#SBATCH --nodes=7
#SBATCH --partition=cpu
#SBATCH --constraint="scratch"
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --ntasks-per-node=120
#SBATCH --cpus-per-task=1
export OMP_NUM_THREADS=1
ulimit -s unlimited
module load cmake
module load gcc-runtime/8.5.0
module load openmpi/4.1.5+cuda
module list
cmake --version
which mpicc

export NEK_SOURCE_ROOT="/projects/bcla/knguyen16/Nek5000"
export PATH=$NEK_SOURCE_ROOT/bin:$PATH

PPLIST="HYPRE" makenek

ldd ./nek5000
export OMP_NUM_THREADS=1
# Workaround for https://github.com/Nek5000/Nek5000/issues/759
export FI_OFI_RXM_RX_SIZE=32768
echo "job start"
TZ='America/Chicago' date
srun --ntasks=840 --nodes=7 --ntasks-per-node=120 --cpus-per-task=1 ./nek5000
